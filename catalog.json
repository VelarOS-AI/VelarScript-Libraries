{
  "formatVersion": 2,
  "distribution": {
    "kind": "npm-registry",
    "scope": "@velarscript-labs",
    "access": "public"
  },
  "packages": [
    {
      "name": "@velarscript-labs/database",
      "path": "packages/database",
      "kind": "source-library",
      "status": "experimental",
      "supportedVelarScript": ">=0.13.0 <0.15.0",
      "targets": ["core", "node", "web", "desktop"]
    },
    {
      "name": "@velarscript-labs/text-buffer",
      "path": "packages/text-buffer",
      "kind": "source-library",
      "status": "stable",
      "supportedVelarScript": ">=0.13.0 <0.14.0",
      "targets": ["core", "node", "web", "desktop"]
    },
    {
      "name": "@velarscript-labs/noise",
      "path": "packages/noise",
      "kind": "adapter",
      "status": "experimental",
      "supportedVelarScript": ">=0.13.0 <0.14.0",
      "targets": ["core", "node", "web", "desktop"]
    },
    {
      "name": "@velarscript-labs/msgpack",
      "path": "packages/msgpack",
      "kind": "adapter",
      "status": "experimental",
      "supportedVelarScript": ">=0.13.0 <0.15.0",
      "targets": ["core", "node", "web", "desktop"]
    },
    {
      "name": "@velarscript-labs/compression",
      "path": "packages/compression",
      "kind": "adapter",
      "status": "experimental",
      "supportedVelarScript": ">=0.13.0 <0.14.0",
      "targets": ["core", "node", "web", "desktop"]
    },
    {
      "name": "@velarscript-labs/editor-kit",
      "path": "packages/editor-kit",
      "kind": "tooling",
      "status": "experimental",
      "supportedVelarScript": ">=0.13.0 <0.14.0",
      "targets": []
    },
    {
      "name": "@velarscript-labs/yaml",
      "path": "packages/yaml",
      "kind": "adapter",
      "status": "experimental",
      "supportedVelarScript": ">=0.13.0 <0.15.0",
      "targets": ["core", "node", "web", "desktop"]
    },
    {
      "name": "@velarscript-labs/sqlite",
      "path": "packages/sqlite",
      "kind": "adapter",
      "status": "experimental",
      "supportedVelarScript": ">=0.13.0 <0.15.0",
      "targets": ["node"]
    }
  ]
}
