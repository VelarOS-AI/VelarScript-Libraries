{
  "name": "@velarscript-labs/sqlite",
  "version": "0.2.2",
  "description": "Bounded asynchronous SQLite capability for VelarScript Node applications.",
  "license": "Apache-2.0",
  "type": "module",
  "files": [
    "src/index.vel",
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "velar build-library",
    "check": "velar format --check && velar check",
    "test": "velar test"
  },
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VelarOS-AI/VelarScript-Libraries.git",
    "directory": "packages/sqlite"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "velar": {
    "entry": "src/index.vel",
    "artifacts": { "node": "dist/velar-library.json" },
    "targets": ["node"],
    "requires": {"capabilities": ["node"], "language": ">=0.13 <0.15"}
  },
  "dependencies": {
    "@velarscript-labs/database": "0.2.2"
  }
}
