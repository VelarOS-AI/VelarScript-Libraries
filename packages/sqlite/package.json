{
  "name": "@velarscript/sqlite",
  "version": "0.2.0",
  "description": "Bounded asynchronous SQLite capability for VelarScript Node applications.",
  "license": "Apache-2.0",
  "type": "module",
  "files": [
    "src/index.vel",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "velar format --check && velar check",
    "test": "velar test"
  },
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VelarOS-AI/VelarScript-Libraries.git",
    "directory": "packages/sqlite"
  },
  "publishConfig": {
    "access": "public"
  },
  "velar": {
    "entry": "src/index.vel",
    "targets": ["node"],
    "requires": {"capabilities": ["node"], "language": ">=0.13 <0.14"}
  },
  "dependencies": {
    "@velarscript/database": "0.2.0"
  }
}
