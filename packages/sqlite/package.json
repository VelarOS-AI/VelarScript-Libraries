{
  "name": "@velarscript-labs/sqlite",
  "version": "0.3.3",
  "description": "Injection-resistant bounded SQLite capability for VelarScript Node applications.",
  "license": "Apache-2.0",
  "type": "module",
  "files": [
    "src/index.vel",
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "velar build-library",
    "check": "velar format --check && velar check",
    "test": "velar test"
  },
  "engines": {
    "node": ">=24.12"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VelarOS-AI/VelarScript-Libraries.git",
    "directory": "packages/sqlite"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "velar": {
    "entry": "src/index.vel",
    "artifacts": {
      "node": "dist/velar-library.json"
    },
    "targets": [
      "node"
    ],
    "requires": {
      "capabilities": [
        "node"
      ],
      "language": ">=0.18 <0.19"
    }
  },
  "dependencies": {
    "@velarscript-labs/database": "0.3.3",
    "sqlite3-parser": "0.7.1"
  }
}
