{
  "name": "@velarscript-labs/sqlite",
  "version": "0.3.5",
  "description": "Injection-resistant bounded SQLite capability for VelarScript Node applications.",
  "license": "Apache-2.0",
  "type": "module",
  "files": [
    "src/index.vel",
    "src/generated/worker-source.vel",
    "dist",
    "README.md",
    "CHANGELOG.md",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE"
  ],
  "scripts": {
    "generate:worker": "node scripts/generate-worker.mjs",
    "prebuild": "npm run generate:worker",
    "build": "velar build-library",
    "precheck": "npm run generate:worker -- --check",
    "check": "velar format --check && velar check",
    "pretest": "npm run generate:worker -- --check",
    "test": "velar test && node --test tests/*.test.mjs"
  },
  "engines": {
    "node": ">=24.12"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VelarOS-AI/VelarScript-Libraries.git",
    "directory": "packages/sqlite"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "velar": {
    "entry": "src/index.vel",
    "artifacts": {
      "node": "dist/velar-library.json"
    },
    "targets": [
      "node"
    ],
    "requires": {
      "capabilities": [
        "node"
      ],
      "language": ">=0.34 <0.35"
    }
  },
  "dependencies": {
    "@velarscript-labs/database": "0.3.4"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "sqlite3-parser": "0.7.1"
  }
}
