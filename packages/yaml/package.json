{
  "name": "@velarscript-labs/yaml",
  "version": "0.1.5",
  "description": "Bounded strict YAML parsing for VelarScript data boundaries.",
  "license": "Apache-2.0",
  "type": "module",
  "files": [
    "src/index.vel",
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "velar build-library",
    "check": "velar format --check && velar check",
    "test": "velar test"
  },
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VelarOS-AI/VelarScript-Libraries.git",
    "directory": "packages/yaml"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "velar": {
    "entry": "src/index.vel",
    "artifacts": {
      "core": "dist/velar-library.json"
    },
    "targets": [
      "core",
      "node",
      "web",
      "desktop"
    ],
    "requires": {
      "capabilities": [],
      "language": ">=0.18 <0.19"
    }
  },
  "dependencies": {
    "yaml": "^2.9.0"
  }
}
