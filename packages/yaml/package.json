{
  "name": "@velarscript-labs/yaml",
  "version": "0.1.6",
  "description": "Bounded strict YAML parsing for VelarScript data boundaries.",
  "license": "Apache-2.0",
  "type": "module",
  "files": [
    "src/index.vel",
    "src/generated/runtime.vel",
    "dist",
    "README.md",
    "CHANGELOG.md",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE"
  ],
  "scripts": {
    "generate:runtime": "node scripts/generate-runtime.mjs",
    "prebuild": "npm run generate:runtime",
    "build": "velar build-library",
    "precheck": "npm run generate:runtime -- --check",
    "check": "velar format --check && velar check",
    "pretest": "npm run generate:runtime -- --check",
    "test": "velar test && node --test tests/*.test.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VelarOS-AI/VelarScript-Libraries.git",
    "directory": "packages/yaml"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "velar": {
    "entry": "src/index.vel",
    "artifacts": {
      "core": "dist/velar-library.json"
    },
    "targets": [
      "core",
      "node",
      "web",
      "desktop"
    ],
    "requires": {
      "capabilities": [],
      "language": ">=0.18 <0.19"
    }
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "yaml": "2.9.1",
    "@velarscript/cli": "0.18.0"
  }
}
