{
  "name": "@velarscript-labs/sql",
  "version": "0.1.1",
  "description": "Injection-resistant Velar-style SQL DML builders over structured database statements.",
  "license": "Apache-2.0",
  "type": "module",
  "files": [
    "src/index.vel",
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "velar build-library",
    "check": "velar format --check && velar check",
    "test": "velar test"
  },
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VelarOS-AI/VelarScript-Libraries.git",
    "directory": "packages/sql"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "velar": {
    "entry": "src/index.vel",
    "artifacts": { "core": "dist/velar-library.json" },
    "targets": ["core", "node", "web", "desktop"],
    "requires": {"capabilities": [], "language": ">=0.14 <0.15"}
  },
  "dependencies": {
    "@velarscript-labs/database": "0.3.1"
  }
}
