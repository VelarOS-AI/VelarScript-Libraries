/// Draws an encoded screencast frame stream onto a canvas the host application owns.
///
/// The adapter never opens a screencast session, never acknowledges a frame, and
/// never maps an input event: transport belongs to the application, and this
/// package only turns encoded bytes into pixels on one canvas element.
import {Bytes} from "velar/binary"

/// The largest encoded frame the adapter accepts. A screencast frame is a single
/// still image; anything past this is a transport defect rather than a picture.
const maxFrameBytes = 16 * 1024 * 1024

/// The largest frame edge the adapter accepts, in encoded pixels.
const maxFrameEdge = 16384

/// Bounds for the pull error stream. One entry per failed frame; a consumer that
/// never pulls costs a fixed, small amount of memory.
const defaultErrorCapacity = 32
const maxErrorCapacity = 1024

/// The encoded image formats a screencast frame may carry.
export enum FrameFormat:
    jpeg
    png

/// One encoded frame's declared metadata. `width` and `height` are the encoded
/// image's own pixel dimensions, which the adapter verifies after decoding.
export type FrameInfo:
    width: number
    height: number
    format: FrameFormat

/// A rectangle on the canvas backing store, in device pixels.
export type ContentBounds:
    x: number
    y: number
    width: number
    height: number

/// Where the most recent frame is drawn and how it is scaled.
///
/// `contentBounds` is the letterboxed destination rectangle in backing-store
/// (device) pixels, `scale` is device pixels per frame pixel, and `pixelRatio` is
/// device pixels per CSS pixel. An application maps a CSS-pixel pointer position
/// `p` measured from the canvas's content box back to frame coordinates with
/// `(p * pixelRatio - contentBounds.origin) / scale`. Before the first frame is
/// drawn `scale` is `0` and the bounds are empty.
export type SurfaceGeometry:
    contentBounds: ContentBounds
    scale: number
    pixelRatio: number

/// One frame the surface could not draw. `sequence` is the frame's submission
/// number, counting from 1. `dropped` is how many error records the bounded
/// stream discarded between the previous delivered record and this one.
export type ScreencastError:
    sequence: number
    reason: string
    dropped: number

/// What the surface has done with the frames it was given. `dropped` counts
/// frames replaced by a newer frame before their decode started, which is the
/// keep-latest discipline working rather than a failure; `failed` counts frames
/// that reached the decoder and did not produce a drawable image.
export type ScreencastStats:
    submitted: number
    drawn: number
    dropped: number
    failed: number
    lastDrawnSequence: number

/// Attachment options. `errorCapacity` bounds the pull error stream, and
/// `pixelRatio` fixes the backing-store scale instead of following the host's
/// `devicePixelRatio`.
export type ScreencastOptions:
    errorCapacity: number?
    pixelRatio: number?

