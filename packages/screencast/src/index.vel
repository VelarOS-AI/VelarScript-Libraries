/// One canvas being driven by a frame stream. Own it with `using`; releasing
/// stops decoding, discards the frame waiting to be decoded, and detaches the
/// canvas.
export class ScreencastSurface:
    constructor(private const native: NativeScreencastSurface): pass

    /// Hands one encoded frame to the surface.
    ///
    /// The frame is decoded off the calling task. At most one frame is ever
    /// waiting to be decoded, so a producer faster than the decoder replaces the
    /// waiting frame instead of queueing behind it and never grows memory.
    /// Submitting to a released surface fails.
    def submitFrame(bytes: Bytes, frame: FrameInfo):
        assert bytes.size > 0 else "A screencast frame cannot be empty"
        assert bytes.size <= maxFrameBytes else f"A screencast frame cannot exceed {maxFrameBytes} bytes"
        assert frame.width.isInteger() and frame.width >= 1 and frame.width <= maxFrameEdge else f"A screencast frame width must be an integer from 1 through {maxFrameEdge}"
        assert frame.height.isInteger() and frame.height >= 1 and frame.height <= maxFrameEdge else f"A screencast frame height must be an integer from 1 through {maxFrameEdge}"
        self.native.submitFrame(bytes, frame.width, frame.height, frame.format)

