/// The surface's bounded pull stream of frames it could not draw.
///
/// One record per failed frame, oldest first, and one active pull at a time. A
/// decode failure never stops the surface: the frames after it are decoded and
/// drawn whether or not anybody is reading this stream. Once the surface is
/// released the stream drains what it already holds and then answers `null`.
export class ScreencastErrorStream:
    constructor(private const native: NativeScreencastSurface): pass

    /// Pulls the next failed frame, or `null` once the surface is released and
    /// the queue is drained.
    async def next() -> ScreencastError?:
        const value = await self.native.nextError()
