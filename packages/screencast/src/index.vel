    @dispose: self.release()

def checkedOptions(options: ScreencastOptions) -> ScreencastOptions:
    const capacity = options.errorCapacity
    if capacity != null:
        assert capacity.isInteger() and capacity >= 1 and capacity <= maxErrorCapacity else f"A screencast errorCapacity must be an integer from 1 through {maxErrorCapacity}"
    const ratio = options.pixelRatio
    if ratio != null:
        assert ratio.isFinite() and ratio >= 0.25 and ratio <= 8 else "A screencast pixelRatio must be a finite number from 0.25 through 8"
    return options

/// Attaches a frame stream to one canvas element the application already
/// rendered, and hands back the owned surface.
///
/// The canvas crosses the boundary by raw identity, which is why it is declared
/// as untyped host data here and validated as a real canvas element before any
/// frame is accepted. The adapter owns the canvas's backing store for the life
/// of the surface and sizes it from the element's content box times the pixel
/// ratio, so the element itself must carry no padding or border.
export def attach(canvas: unknown, options: ScreencastOptions = {}) -> ScreencastSurface:
    return ScreencastSurface(attachNativeScreencast(canvas, checkedOptions(options)))
