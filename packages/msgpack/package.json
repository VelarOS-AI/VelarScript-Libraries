{
  "name": "@velarscript-labs/msgpack",
  "version": "0.1.3",
  "description": "Bounded MessagePack adapter for VelarScript.",
  "license": "Apache-2.0",
  "type": "module",
  "files": [
    "src/index.vel",
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "velar build-library",
    "check": "velar format --check && velar check",
    "test": "velar test"
  },
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VelarOS-AI/VelarScript-Libraries.git",
    "directory": "packages/msgpack"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "velar": {
    "entry": "src/index.vel",
    "artifacts": { "core": "dist/velar-library.json" },
    "targets": ["core", "node", "web", "desktop"],
    "requires": { "capabilities": [], "language": ">=0.13 <0.15" }
  },
  "dependencies": {
    "msgpackr": "^2.0.5"
  }
}
