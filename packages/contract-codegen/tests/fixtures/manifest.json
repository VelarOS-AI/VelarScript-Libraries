{
  "formatVersion": 1,
  "resolveFrom": "./contracts",
  "outputDirectory": "./vel/generated",
  "naming": {
    "stripSuffix": "Schema",
    "prefix": ""
  },
  "velarFormat": true,
  "modules": [
    {
      "specifier": "./contracts.mjs",
      "output": "contracts.vel",
      "exports": "all",
      "unknownDegrade": [
        {
          "path": "DegradedSchema.protocolVersion",
          "reason": "the consumer forwards this envelope to another process without reading its version, so the position is opaque data here even though the table now maps an integer literal"
        }
      ]
    }
  ],
  "channelTables": [
    {
      "output": "channels.vel",
      "enumName": "FixtureChannel",
      "typesOutput": "contracts.vel",
      "channels": [
        {
          "name": "chat:stream-event",
          "event": "EnvelopeSchema"
        },
        {
          "name": "chat:describe-article",
          "request": "ArticleSchema",
          "response": "AuthorSchema"
        },
        {
          "name": "mod:kind",
          "request": "KindSchema"
        }
      ]
    }
  ]
}
