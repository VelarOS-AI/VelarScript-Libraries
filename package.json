{
  "name": "velarscript-libraries-workspace",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "node scripts/run-workspaces.mjs build",
    "check": "node scripts/check-repository.mjs && node scripts/run-workspaces.mjs check",
    "test": "node scripts/run-workspaces.mjs test",
    "pack:check": "npm run build && node scripts/verify-packed-consumers.mjs",
    "publish:npm": "node scripts/publish-npm.mjs",
    "validate": "npm run check && npm test && npm run pack:check"
  },
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VelarOS-AI/VelarScript-Libraries.git"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "@velarscript/cli": "0.18.0",
    "typescript": "^7.0.2"
  }
}
